# Copy to .env and adjust. Every value is optional in development.

# Public URL of the app. Encoded into table QR codes and Stripe redirect URLs.
APP_URL=http://localhost:3000
PORT=3000

# SQLite database file (created and migrated automatically on start).
DATABASE_URL=./data/biteflow.db

RESTAURANT_NAME="BiteFlow Bistro"
CURRENCY=USD
LOCALE=en-US

# Demo mode seeds sample orders, shows a "Try a demo table" button and the
# staff PIN on the sign-in screen. On by default in development, off in production.
DEMO_MODE=true

# 4-digit PIN for the first staff account (only used when the database is created).
STAFF_DEMO_PIN=1234

# Private 4-digit PIN for the manager account. Only managers can delete menu items
# or tables, regenerate QR codes, import the sample menu or reset demo data.
# In demo mode the public STAFF_DEMO_PIN is always a plain staff account.
MANAGER_PIN=
SESSION_TTL_HOURS=12

# Stripe (optional). Without a key, card payments use a clearly labelled demo flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
